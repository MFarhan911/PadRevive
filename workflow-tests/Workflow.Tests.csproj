<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>GenericPadBridge</AssemblyName><StartupObject>WorkflowTests</StartupObject><NoWarn>$(NoWarn);WFO0003</NoWarn>
 </PropertyGroup>
 <ItemGroup>
  <Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/>
  <!-- Run the actual window and event handlers with a synthetic bridge; never open physical devices. -->
  <Compile Include="../GenericPadBridge/*.cs" Exclude="../GenericPadBridge/Bridge.cs;../GenericPadBridge/App.xaml.cs" Link="AppSource/%(Filename)%(Extension)"/>
  <Page Include="../GenericPadBridge/*.xaml" Exclude="../GenericPadBridge/App.xaml" Link="%(Filename)%(Extension)"/>
  <Resource Include="../GenericPadBridge/Assets/*-v9.png" Link="Assets/%(Filename)%(Extension)"/>
  <Reference Include="LibTessDotNet"><HintPath>../GenericPadBridge/lib/LibTessDotNet.dll</HintPath></Reference>
 </ItemGroup>
</Project>
