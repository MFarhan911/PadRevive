       <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="25"><StackPanel><TextBlock Text="Right stick" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Horizontal source" Foreground="#92A6C3" FontSize="11" Margin="0,23,0,9"/><ComboBox x:Name="RightXSelect" SelectionChanged="Axis_Changed"/><TextBlock Text="Vertical source" Foreground="#92A6C3" FontSize="11" Margin="0,17,0,9"/><ComboBox x:Name="RightYSelect" SelectionChanged="Axis_Changed"/><CheckBox x:Name="InvertRightX" Content="Invert horizontal direction" Margin="0,22,0,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="InvertRightY" Content="Invert vertical direction" Margin="0,22,0,0" Checked="Settings_Changed" Unchecked="Settings_Changed"/></StackPanel></Border>
      </Grid>
      <Border Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="25" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="DeadzoneText" Text="Deadzone 8%" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Keep small stick drift out of the virtual output. The controller markers show physical movement." Foreground="#8DA3C0" FontSize="12" Margin="0,8,0,5"/><Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="0.5" SmallChange="0.01" ValueChanged="Slider_Changed"/><TextBlock x:Name="DpadText" Foreground="#71EBC6" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>

      <Border Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="25" Margin="0,16,0,0"><StackPanel><TextBlock Text="Analog triggers" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose an axis, or use Controller setup to learn the resting and fully pressed positions. Digital triggers can remain button assignments." Foreground="#8DA3C0" FontSize="12" Margin="0,8,0,18"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Left trigger source" FontSize="11" Foreground="#92A6C3" Margin="0,0,0,9"/><ComboBox x:Name="LeftTriggerSource" SelectionChanged="TriggerAxis_Changed"/><CheckBox x:Name="ReverseLeftTrigger" Content="Reverse trigger range" Margin="0,15,0,0" Checked="TriggerReverse_Changed" Unchecked="TriggerReverse_Changed"/><TextBlock x:Name="LeftCalibrationText" Foreground="#859CB9" FontSize="10" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Right trigger source" FontSize="11" Foreground="#92A6C3" Margin="0,0,0,9"/><ComboBox x:Name="RightTriggerSource" SelectionChanged="TriggerAxis_Changed"/><CheckBox x:Name="ReverseRightTrigger" Content="Reverse trigger range" Margin="0,15,0,0" Checked="TriggerReverse_Changed" Unchecked="TriggerReverse_Changed"/><TextBlock x:Name="RightCalibrationText" Foreground="#859CB9" FontSize="10" Margin="0,10,0,0"/></StackPanel></Grid>
       <TextBlock Text="D-pad hat source" FontSize="11" Foreground="#92A6C3" Margin="0,23,0,9"/><ComboBox x:Name="PovSelect" SelectionChanged="Pov_Changed"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Rumble">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="25"><StackPanel><TextBlock Text="Feel every input" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Native USB or XInput vibration, when supported by the selected device." Foreground="#8DA3C0" FontSize="12" Margin="0,8,0,23"/><CheckBox x:Name="ForwardRumble" Content="Forward game vibration" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Motor routing" Foreground="#92A6C3" FontSize="11" Margin="0,23,0,9"/><ComboBox x:Name="RoutingSelect" SelectionChanged="Routing_Changed"><ComboBoxItem Content="Normal · separate motors"/><ComboBoxItem Content="Swap · exchange motors"/><ComboBoxItem Content="Mono · combine motors"/></ComboBox><TextBlock x:Name="StrongText" Text="Strong gain 100%" Margin="0,24,0,0"/><Slider x:Name="StrongSlider" Minimum="0" Maximum="1" ValueChanged="Slider_Changed"/><TextBlock x:Name="WeakText" Text="Weak gain 100%" Margin="0,13,0,0"/><Slider x:Name="WeakSlider" Minimum="0" Maximum="1" ValueChanged="Slider_Changed"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="25"><StackPanel><TextBlock Text="Motor test" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Test each motor for one second." Foreground="#8DA3C0" FontSize="12" Margin="0,8,0,21"/><Button x:Name="TestBoth" Content="Both · 1 sec" Tag="both" Click="Test_Click" IsEnabled="False"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="TestStrong" Content="Strong" Tag="strong" Click="Test_Click" Style="{StaticResource Secondary}" IsEnabled="False"/><Button x:Name="TestWeak" Grid.Column="2" Content="Weak" Tag="weak" Click="Test_Click" Style="{StaticResource Secondary}" IsEnabled="False"/></Grid><Button Content="Stop motors" Click="Stop_Click" Style="{StaticResource Secondary}" Margin="0,10,0,0"/><TextBlock Text="Direct tests bypass gains and stop when this window loses focus." Foreground="#7D92AE" FontSize="11" Margin="0,20,0,0"/><Border Height="1" Background="#293345" Margin="0,22,0,18"/><TextBlock x:Name="RumbleText" Text="Waiting for controller" Foreground="#71EBC6" FontSize="11"/></StackPanel></Border>
     </Grid></ScrollViewer>
    </TabItem>

    <TabItem x:Name="SetupTab" Header="Setup">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="28"><StackPanel><TextBlock Text="Make any layout yours" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Learn a controller's physical controls one at a time. Windows must already expose it through DirectInput or XInput." FontSize="12" Foreground="#A1B1CB" Margin="0,9,0,18"/><TextBlock x:Name="SupportText" Text="Connect a controller to see its input and rumble support." Foreground="#88DDC6" FontSize="12"/>
       <Border Background="#60292848" BorderBrush="#66544D7A" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,23,0,0"><StackPanel><TextBlock x:Name="SetupStepText" Text="CONTROLLER SETUP" FontSize="10" Foreground="#B5A5DB"/><TextBlock x:Name="SetupPromptText" Text="Ready when you are" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,7"/><TextBlock x:Name="SetupHintText" Text="Leave the sticks and triggers at rest before starting. Skip controls your device does not have. Virtual output pauses during setup." FontSize="12" Foreground="#9DABC6"/><ProgressBar x:Name="SetupProgress" Height="4" Maximum="21" Foreground="#BAA5FF" Background="#35364F" BorderThickness="0" Margin="0,22,0,0"/>
        <WrapPanel Margin="0,22,0,0"><Button x:Name="StartSetupButton" Content="Start controller setup" Click="StartSetup_Click" IsEnabled="False" Margin="0,0,9,8"/><Button x:Name="AcceptSetupButton" Content="Accept movement" Click="AcceptSetup_Click" Style="{StaticResource Secondary}" IsEnabled="False" Margin="0,0,9,8"/><Button x:Name="SkipSetupButton" Content="Skip control" Click="SkipSetup_Click" Style="{StaticResource Quiet}" IsEnabled="False" Margin="0,0,9,8"/><Button x:Name="CancelSetupButton" Content="Cancel" Click="CancelSetup_Click" Style="{StaticResource Quiet}" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
       <TextBlock Text="Buttons and D-pad steps advance after a new press. For sticks and analog triggers, hold the full movement and click Accept movement, then release. The learned layout applies when setup finishes; Save profile keeps it." FontSize="11" Foreground="#8098B7" Margin="0,18,0,0"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="25" Margin="0,16,0,0"><StackPanel><TextBlock Text="Take your profile with you" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Export a local JSON profile to share a layout or move it to another PC. Importing updates the current controller's mapping." Foreground="#8DA3C0" FontSize="12" Margin="0,8,0,18"/><WrapPanel><Button Content="Export profile" Click="ExportProfile_Click" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button Content="Import profile" Click="ImportProfile_Click" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="About">
     <Border Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="25"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="PadRevive 0.12.0 Beta 2" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Budget gear. Full play. · Powered by GenericPadBridge" FontSize="12" Foreground="#A29ABD" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,21,0,21"><TextBlock Text="A single EXE with the .NET runtime included. Xbox 360 / DS4 emulation requires ViGEmBus installed separately. No BAT launcher or command window is needed." Foreground="#A1B1CB" FontSize="12"/><TextBlock Text="Input: DirectInput USB/Bluetooth controllers and native XInput. Presets: your 0810:0001 layout, DualShock 4, DualSense, and XInput. Rumble: supported 0810:0001 descriptors and native XInput. Native PlayStation motor output, adaptive triggers and motion sensors are unavailable. Workbench adds arcade mapping, health and calibration, offline profiles, accessibility, game rules and optional HidHide integration. Revive Lab adds directional stick rescue, tested variants, combination audits, motor feel calibration, repair history, input traces and controller reference images." Foreground="#90A4C0" FontSize="11" Margin="0,13,0,0"/><TextBlock Text="Open source under GPL-3.0-or-later. Profiles and diagnostics stay local. This public beta is ready for community testing. Credits and redistribution notices travel inside this EXE." Foreground="#79BFAE" FontSize="11" Margin="0,13,0,0"/><Border Background="#242A40" CornerRadius="10" Padding="14" Margin="0,15,0,0"><StackPanel><TextBlock Text="Appearance &amp; startup" FontSize="13" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><CheckBox x:Name="StartupEnabled" Content="Play intro at startup" Checked="Appearance_Changed" Unchecked="Appearance_Changed" Margin="0,0,22,0"/><CheckBox x:Name="ReduceMotion" Content="Reduce motion" Checked="Appearance_Changed" Unchecked="Appearance_Changed" Margin="0,0,22,0"/><Button x:Name="ReplayIntroButton" Content="Replay intro" Click="ReplayIntro_Click" Style="{StaticResource Quiet}"/></StackPanel><TextBlock x:Name="MotionHint" FontSize="10" Foreground="#8097B5" Margin="0,9,0,0"/><TextBlock Text="Original universal artwork with colour-matched underlighting. All startup controllers converge into the main gamepad. Choose Xbox 360 or DualShock 4 output in the sidebar." FontSize="10" Foreground="#667F9D" Margin="0,6,0,0"/></StackPanel></Border></StackPanel><TextBox Grid.Row="2" x:Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/></Grid></Border>
    </TabItem>
    <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
     <Border Background="{StaticResource Panel}" CornerRadius="15" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="21"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Connection details" FontSize="22" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Refresh" Click="RefreshDiagnostics_Click" Style="{StaticResource Quiet}"/><Button Content="Copy diagnostics" Click="Diagnostics_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0"/></StackPanel></DockPanel><TextBlock Grid.Row="1" x:Name="RawText" Text="No physical input yet." Foreground="#71EBC6" FontFamily="Consolas" FontSize="11" Margin="0,17,0,17"/><TextBox Grid.Row="2" x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Text="Connect your controller, then Refresh to view the native report."/></Grid></Border>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="2" Margin="0,17,0,0"><TextBlock x:Name="ConnectionText" Text="Checking physical controller…" FontSize="10" Foreground="#82A999"/><TextBlock x:Name="FooterText" Text="Click a control to remap it. Highlights come from your connected controller." Foreground="#637C9A" FontSize="10" Margin="0,5,0,0"/></StackPanel>
  </Grid>
 </Grid>
  </Grid>
  <local:ReferenceDashboard x:Name="Dashboard"/>
  <local:StartupView x:Name="Intro" Panel.ZIndex="30"/>
 </Grid>
