<UserControl x:Class="GenericPadBridge.InputTestView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GenericPadBridge">
 <Border Background="#B91B2135" BorderBrush="#42485576" BorderThickness="1" CornerRadius="15" Padding="22">
  <Grid x:Name="TestPanel" ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Viewbox Grid.RowSpan="3" x:Name="Backdrop" Stretch="Uniform" Opacity="0.20" IsHitTestVisible="False" Margin="-18"><Viewbox.Effect><BlurEffect Radius="7" RenderingBias="Performance"/></Viewbox.Effect><Viewbox.CacheMode><BitmapCache/></Viewbox.CacheMode><Image x:Name="BackdropArt" Width="1536" Height="1024" Stretch="Uniform"/></Viewbox>
   <Grid Panel.ZIndex="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Put every button to the test" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SessionStatus" Text="Connect a controller to test physical input." FontSize="11" Foreground="#8DA3C0" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><ComboBox x:Name="LabelMode" SelectedIndex="0" SelectionChanged="LabelMode_Changed" Width="149" FontSize="11"><ComboBoxItem Content="Output labels"/><ComboBoxItem Content="Controller stickers"/></ComboBox><Button Content="Preview" Click="Preview_Click" ToolTip="Preview a visual splash; no input is sent." Margin="8,0,0,0" Padding="10,8" FontSize="11"/><Button Content="Reset" Click="Reset_Click" Margin="8,0,0,0" Padding="12,8" FontSize="11"/></StackPanel>
   </Grid>
   <Grid Grid.RowSpan="3" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel Width="150"><TextBlock Text="LEFT STICK" Foreground="#7188A6" FontSize="10" TextAlignment="Center"/><Canvas Width="114" Height="114" Margin="0,13,0,10"><Ellipse Width="114" Height="114" Stroke="#35445D" Fill="#70141D2A"/><Line X1="57" Y1="12" X2="57" Y2="102" Stroke="#2A374F"/><Line X1="12" Y1="57" X2="102" Y2="57" Stroke="#2A374F"/><Ellipse x:Name="LeftMarker" Width="14" Height="14" Fill="#71EBC6" Canvas.Left="50" Canvas.Top="50"/></Canvas><TextBlock x:Name="LeftReading" Text="X +0.00  Y +0.00" Foreground="#96B7BE" FontSize="10" FontFamily="Consolas" TextAlignment="Center"/><TextBlock x:Name="LeftTriggerReading" Text="LT 0%" FontSize="11" Foreground="#86CABC" TextAlignment="Center" Margin="0,20,0,6"/><ProgressBar x:Name="LeftTriggerBar" Maximum="255" Height="4" Margin="15,0" Background="#263447" Foreground="#71EBC6" BorderThickness="0"/></StackPanel></Viewbox>
    <Grid Grid.Column="1" ClipToBounds="False">
     <Viewbox x:Name="SplashFrame" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Width="242" Height="242"><Grid Width="242" Height="242">
      <Ellipse x:Name="SplashWave" Stroke="#A9DBEE" StrokeThickness="1.5" Margin="35" Opacity="0" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
      <Ellipse x:Name="SplashHalo" Width="196" Height="196" Fill="#121D3044" Stroke="#41526C" StrokeThickness="1.5"><Ellipse.Effect><DropShadowEffect x:Name="SplashGlow" Color="#81EBDD" BlurRadius="34" ShadowDepth="0" Opacity=".16"/></Ellipse.Effect></Ellipse>
      <Grid x:Name="SplashContent" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform><local:StickerGlyph x:Name="SplashGlyph" Text="—" Width="128" Height="128" Foreground="#64748A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
     </Grid></Viewbox>
     
    </Grid>
    <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly"><StackPanel Width="150"><TextBlock Text="RIGHT STICK" Foreground="#7188A6" FontSize="10" TextAlignment="Center"/><Canvas Width="114" Height="114" Margin="0,13,0,10"><Ellipse Width="114" Height="114" Stroke="#35445D" Fill="#70141D2A"/><Line X1="57" Y1="12" X2="57" Y2="102" Stroke="#2A374F"/><Line X1="12" Y1="57" X2="102" Y2="57" Stroke="#2A374F"/><Ellipse x:Name="RightMarker" Width="14" Height="14" Fill="#B9A9FF" Canvas.Left="50" Canvas.Top="50"/></Canvas><TextBlock x:Name="RightReading" Text="X +0.00  Y +0.00" Foreground="#B9AECE" FontSize="10" FontFamily="Consolas" TextAlignment="Center"/><TextBlock x:Name="RightTriggerReading" Text="RT 0%" FontSize="11" Foreground="#BCABE6" TextAlignment="Center" Margin="0,20,0,6"/><ProgressBar x:Name="RightTriggerBar" Maximum="255" Height="4" Margin="15,0" Background="#263447" Foreground="#B9A9FF" BorderThickness="0"/></StackPanel></Viewbox>
   </Grid>
   <StackPanel Grid.RowSpan="3" VerticalAlignment="Top" Margin="150,64,150,0" IsHitTestVisible="False"><TextBlock x:Name="SplashName" Text="Press a controller button" FontSize="16" Height="24" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SplashDetail" Text="Every press gets its own sticker." Height="17" FontSize="10" Foreground="#869DB8" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Row="2" Panel.ZIndex="2"><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="INDIVIDUAL CONTROLS" Foreground="#7E93AD" FontSize="9" FontWeight="SemiBold"/><TextBlock x:Name="Stats" Grid.Column="1" Text="0 presses · 0 held · 0 seen" FontSize="10" Foreground="#A0B6D0"/></Grid>
    <ScrollViewer x:Name="CardScroll" MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="ControlCards"/></ScrollViewer>
    <TextBlock Text="Press your physical controls to count inputs. Click a card to preview its splash; previews send no controller input." FontSize="9" Foreground="#667F9D" Margin="0,6,0,0"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
